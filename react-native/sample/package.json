{
  "name": "zellio-chat-react-native-sample",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/ensure-config.js",
    "fixture-server": "node scripts/fixture-server.mjs",
    "prestart": "node scripts/ensure-config.js",
    "start": "react-native start",
    "android": "node scripts/ensure-config.js && react-native run-android",
    "ios": "node scripts/ensure-config.js && react-native run-ios",
    "pods": "node ../scripts/vendor-ios.mjs && cd ios && pod install",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zellio/chat-react-native": "file:..",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
