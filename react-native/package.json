{
  "name": "@zellio/chat-react-native",
  "version": "1.0.0",
  "description": "ZeeChat for React Native: a thin wrapper over the native Zellio chat SDKs for iOS and Android.",
  "license": "Apache-2.0",
  "homepage": "https://zellio.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zellio-ai/zellio-chat-sdk.git",
    "directory": "react-native"
  },
  "bugs": {
    "url": "https://github.com/zellio-ai/zellio-chat-sdk/issues"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "lib",
    "src",
    "android",
    "ios",
    "plugin/build",
    "app.plugin.js",
    "ZellioChatReactNative.podspec",
    "README.md",
    "LICENSE",
    "!**/__tests__",
    "!android/build",
    "!android/.gradle",
    "!ios/build"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p plugin/tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p plugin/tsconfig.json",
    "test": "vitest run",
    "vendor:ios": "node scripts/vendor-ios.mjs",
    "check:version": "node scripts/check-version.mjs",
    "prepack": "node scripts/check-version.mjs && node scripts/vendor-ios.mjs && npm run build",
    "ci": "bash scripts/ci-check.sh"
  },
  "codegenConfig": {
    "name": "RNZellioChatSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "ai.zellio.chat.reactnative"
    }
  },
  "peerDependencies": {
    "expo": ">=58",
    "react": ">=19.1",
    "react-native": ">=0.82"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.3.0",
    "expo": "~58.0.22",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
