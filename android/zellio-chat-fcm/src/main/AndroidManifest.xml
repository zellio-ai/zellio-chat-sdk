<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Remove this service in your manifest (tools:node="remove") if your app has its own
             FirebaseMessagingService, and forward to ZellioFcm from there. -->
        <service
            android:name="ai.zellio.chat.fcm.ZellioMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
